# EvoHub baked defaults (non-sensitive public defaults — the ones already in use).
# docker compose reads this automatically as the `.env` next to the compose file.
# Override at first boot is NOT needed; these ship inside the image.

# Postgres
DB_NAME=postgres
DB_USER=postgres
DB_PASS=postgres

# Grafana admin
GF_ADMIN_USER=admin
GF_ADMIN_PASS=veryhungryphage

# The listener/UI images (evoflow_listener / evoflow_ui) are built ON THE PI at
# first boot from /opt/evohub/src — no registry. See r-pi/README.md.
