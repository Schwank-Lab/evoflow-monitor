# Defaults for connecting to an EvoHub from evo-net, where the hub is always at
# 192.168.4.1. Environment variables of the same name take precedence: the hub's
# own containers set DB_HOST and MQTT_HOST to their compose service names, and
# a laptop reaching the hub over the lab network sets DB_HOST to the hub's IP.

# postgresql config
DB_NAME = 'postgres'
DB_USER ='postgres'
DB_PASS='postgres'
DB_HOST=192.168.4.1
DB_PORT=5432

# mosquitto config
MQTT_HOST=192.168.4.1
MQTT_PORT=1883
MQTT_USER='service_account'
MQTT_PASS='service_pass'
