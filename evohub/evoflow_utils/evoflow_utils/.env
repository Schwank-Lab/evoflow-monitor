# Defaults for connecting to an EvoHub. Environment variables of the same name
# take precedence: the hub's own containers set DB_HOST and MQTT_HOST to their
# compose service names, and Evotool reads EVOHUB_HOST from its own .env.

# Address of the EvoHub, announced by the hub itself over mDNS.
EVOHUB_HOST=evohub.local

# postgresql config
DB_NAME='postgres'
DB_USER='postgres'
DB_PASS='postgres'
DB_HOST=${EVOHUB_HOST}
DB_PORT=5432

# mosquitto config
MQTT_HOST=${EVOHUB_HOST}
MQTT_PORT=1883
MQTT_USER='service_account'
MQTT_PASS='service_pass'
